{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "HNSW_BUILD_TESTS": "ON", "HNSW_BUILD_BENCH": "ON" }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Debug build with tests",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Optimized build (-O3), portable: runtime SIMD dispatch",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "AddressSanitizer + UndefinedBehaviorSanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "HNSW_SANITIZE": "address,undefined",
        "HNSW_BUILD_BENCH": "OFF"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "ThreadSanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "HNSW_SANITIZE": "thread",
        "HNSW_BUILD_BENCH": "OFF"
      }
    },
    {
      "name": "bench",
      "inherits": "base",
      "displayName": "Benchmark build: -O3 -march=native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HNSW_NATIVE": "ON",
        "HNSW_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "bench", "configurePreset": "bench" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
    { "name": "tsan", "configurePreset": "tsan", "output": { "outputOnFailure": true },
      "environment": { "TSAN_OPTIONS": "halt_on_error=1 second_deadlock_stack=1" } }
  ]
}
